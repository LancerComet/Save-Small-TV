@font-face
  font-family: 'KenPixel'
  src: url('../static/fonts/KenPixel.woff2') format('woff2'),
      url('../static/fonts/KenPixel.woff') format('woff')
  font-weight: normal
  font-style: normal
  font-display: swap

html, body
  margin: 0
  padding: 0
  width: 100%
  height: 100%
  overflow: hidden

canvas
  background-color: #000
  display: block
  width: 100vw
  height: 100vh
  image-rendering: pixelated
  image-rendering: crisp-edges
